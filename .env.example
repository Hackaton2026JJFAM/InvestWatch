# Skopiuj do .env (cp .env.example .env). Plik .env nie trafia do repo.
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investwatch

# Port dashboardu na hoście
WEB_PORT=8080

# Harmonogram skanowania źródeł (cron, strefa Europe/Warsaw)
SCAN_CRON=0 */6 * * *
# Domyślny próg ryzyka 0-100 (można zmienić w panelu kalibracji)
DEFAULT_THRESHOLD=45

# Scraper: opcjonalna lista proxy rozdzielona przecinkami (http://host:port)
SCRAPER_PROXIES=
# Pozwala analizować adresy w sieci prywatnej (domyślnie zablokowane – ochrona SSRF)
SCRAPER_ALLOW_PRIVATE=false

# LLM lokalny (profil "llm"). Puste = podsumowanie z szablonu.
OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b

# Załaduj przykładowe materiały przy pierwszym starcie
SEED_DEMO=true
