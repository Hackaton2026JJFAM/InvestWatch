# Skopiuj do .env (cp .env.example .env). Plik .env nie trafia do repo.
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investwatch

# Hasło administratora (zmiana progu, źródła, próbki, usuwanie). Puste = te operacje są wyłączone.
ADMIN_PASSWORD=change-me-admin
# true za reverse proxy z HTTPS (ciasteczko sesji tylko po TLS)
SECURE_COOKIES=false

# Port dashboardu na hoście; WEB_BIND=0.0.0.0 udostępnia go w sieci (aplikacja nie ma logowania)
WEB_PORT=8080
WEB_BIND=127.0.0.1
# Dodatkowe dozwolone Origin dla WebSocket (rozdzielone przecinkami), np. https://investwatch.local
ALLOWED_ORIGINS=

# Harmonogram skanowania źródeł (cron, strefa Europe/Warsaw)
SCAN_CRON=0 */6 * * *
# Domyślny próg ryzyka 0-100 (można zmienić w panelu kalibracji)
DEFAULT_THRESHOLD=45

# Scraper: opcjonalna lista proxy rozdzielona przecinkami (http://host:port)
SCRAPER_PROXIES=
# Pozwala analizować adresy w sieci prywatnej (domyślnie zablokowane – ochrona SSRF)
SCRAPER_ALLOW_PRIVATE=false

# LLM lokalny (profil "llm"). Puste = podsumowanie z szablonu.
OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b

# Automatyczne wzbogacanie nowych spółek: KRS, GLEIF (LEI), lista ostrzeżeń KNF, rejestr MiCA ESMA (wymaga internetu)
ENRICH_AUTO=true

# Załaduj przykładowe materiały i fikcyjne podmioty DEMO przy pierwszym starcie
SEED_DEMO=true
